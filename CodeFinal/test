    private static final String fichierTest = "fichiertest.csv";
    private static final String fichierProjetsTest = "fichierProjetsTest.csv";
    private static final String fichierModificationsTest = "fichierModificationsTest.csv";
    private static final String fichierRequeteTest = "fichierRequeteTest.csv";
    private static final String fichierCandidaturesTest = "fichierCandidaturesTest.csv";
    private static final String fichierMessagesTest = "fichierMessagesTest.csv";

    @BeforeEach
    public void setUp(){
        List<String[]> nomsTest = new ArrayList<>();
        nomsTest.add(new String[] {"nom1", "nom2", "nom3", "nom4"});
        BaseDeDonnees.ecrireTous(fichierTest, nomsTest);

        List<String[]> testNombreProjets = new ArrayList<>();
        testNombreProjets.add(new String[] {"projet1"});
        BaseDeDonnees.ecrireTous(fichierProjetsTest, testNombreProjets);

        List<String[]> testNombreNotifications = new ArrayList<>();
        testNombreNotifications.add(new String[] {"Notification1"});
        BaseDeDonnees.ecrireTous(fichierModificationsTest, testNombreNotifications);

        List<String[]> testRequete = new ArrayList<>();
        testRequete.add(new String[] {"Requete1"});
        BaseDeDonnees.ecrireTous(fichierRequeteTest, testRequete);

        List<String[]> testCandidatures = new ArrayList<>();
        testCandidatures.add(new String[] {"Candidature1"});
        BaseDeDonnees.ecrireTous(fichierCandidaturesTest, testCandidatures);

        List<String[]> testMessages = new ArrayList<>();
        testMessages.add(new String[] {"Message1"});
        BaseDeDonnees.ecrireTous(fichierMessagesTest, testMessages);


    }
    @AfterEach
    public void supprimerFichierTest(){
        new File(fichierTest).delete();
        new File(fichierProjetsTest).delete();
        new File(fichierModificationsTest).delete();
        new File(fichierRequeteTest).delete();
        new File(fichierCandidaturesTest).delete();
        new File(fichierMessagesTest).delete();
    }

    @Test
    public void testVisualiserFichier(){
        List<String[]> resultatsFichierTest = BaseDeDonnees.lireTous(fichierTest);
        Assertions.assertArrayEquals(new String[] {"nom1", "nom2", "nom3", "nom4"}, resultatsFichierTest.get(0));
    }

    @Test
    public void testAjouterLigne(){
        String[] nouvelleLigne = new String[] {"nom5", "nom6", "nom7", "nom8"};
        BaseDeDonnees.ajouterLigne(fichierTest, List.of(nouvelleLigne));
        List<String[]> resultatsFichierTest = BaseDeDonnees.lireTous(fichierTest);

        Assertions.assertEquals(2, resultatsFichierTest.size());
    }

    @Test
    public void testSupprimerLigne(){
        BaseDeDonnees.ConditionSuppression conditionSuppression = enregistrement -> enregistrement[0].equals("nom1");
        String[] nouvelleLigne = new String[] {"nom5", "nom6", "nom7", "nom8"};
        BaseDeDonnees.ajouterLigne(fichierTest, List.of(nouvelleLigne));

        BaseDeDonnees.supprimer(fichierTest, conditionSuppression);

        List<String[]> resultatsFichierTest = BaseDeDonnees.lireTous(fichierTest);
        Assertions.assertEquals(1, resultatsFichierTest.size());
    }

    @Test
    public void testGetNotificationCount(){
        int nombreNotification = Notifications.getNotificationCount(fichierProjetsTest, fichierModificationsTest);
        Assertions.assertEquals(2, nombreNotification);
    }

    @Test
    public void testGetNotificationCountEchoue(){
        int nombreNotification = Notifications.getNotificationCount(fichierProjetsTest, fichierModificationsTest);
        Assertions.assertNotEquals(3, nombreNotification);
    }

    @Test
    public void testPreparerNotifications(){
        List<String[]> testPreparerNotif = new ArrayList<>();
        testPreparerNotif.add(new String[] {"projet1","projet2","projet3","projet4","projet5","projet6","projet7"});

        List<String[]> testNotifs = Notifications.preparerNotifications(testPreparerNotif);

        String[] testExpectativeNotif = new String[]{"Un projet a été soumis","projet1","projet2","projet3","projet4","projet5","projet6","projet7"};

        Assertions.assertArrayEquals(testExpectativeNotif, testNotifs.get(0));
    }

    @Test
    public void testGetStatutRequeteAccepte(){
        List<String[]> testMessagesCandidatures = new ArrayList<>();
        testMessagesCandidatures.add(new String[] {"Requete candidature1", "acceptée"});

        List<String[]> testCandidatures = new ArrayList<>();
        testCandidatures.add(new String[] {"Candidature1"});

        String testStatutRequete = SuiviRequete.getStatutRequete("Requete candidature1", testMessagesCandidatures, testCandidatures);
        Assertions.assertEquals("Candidature acceptée", testStatutRequete, "Le statut de la requête devrait être 'Candidature acceptée'");

    }

    @Test
    public void testGetStatusRequeteSoumise(){
        List<String[]> testMessagesCandidatures = new ArrayList<>();
        testMessagesCandidatures.add(new String[] {"Requete candidature1", "acceptée"});

        List<String[]> testCandidatures = new ArrayList<>();
        testCandidatures.add(new String[] {"Candidature1"});

        String testStatutRequete = SuiviRequete.getStatutRequete("Candidature1", testMessagesCandidatures, testCandidatures);
        Assertions.assertEquals("Candidature soumise", testStatutRequete, "Le statut de la requête devrait être 'Candidature soumise'");
    }

    @Test
    public void testGetStatusRequeteEchoue(){
        List<String[]> testMessagesCandidatures = new ArrayList<>();
        testMessagesCandidatures.add(new String[] {"Requete candidature1", "acceptée"});

        List<String[]> testCandidatures = new ArrayList<>();
        testCandidatures.add(new String[] {"Candidature1"});

        String testStatutRequete = SuiviRequete.getStatutRequete("Candidature1", testMessagesCandidatures, testCandidatures);
        Assertions.assertNotEquals("Candidature acceptée", testStatutRequete, "Le statut de la requête devrait être 'Candidature soumise'");
    }

